# Environment Configuration
NODE_ENV=development
PORT=3002

# Database Configuration
DB_SERVER=localhost
DB_DATABASE=ReactBudget
DB_USER=SaltyUser
DB_PASSWORD=saltypass
# Don't specify port for named instances - let SQL Server resolve it
