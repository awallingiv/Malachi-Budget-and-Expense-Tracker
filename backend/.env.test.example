# Test Environment Configuration
# Copy this to .env.test and update with your test database credentials

# Database Configuration (Test Database)
DB_SERVER=localhost
DB_NAME=MalachiBudget_Test
DB_USER=your_test_user
DB_PASSWORD=your_test_password
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Configuration
JWT_SECRET=test_jwt_secret_key_minimum_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Email Configuration (Optional for tests - can use mock)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=test@example.com
EMAIL_PASSWORD=test_password
EMAIL_FROM=test@example.com

# Environment
NODE_ENV=test
PORT=5001
